<UserControl x:Class="LibrarianDashboard.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Hero Section -->
            <RowDefinition Height="Auto"/> <!-- Row 1: KPIs -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Actions -->
            <RowDefinition Height="*"/>    <!-- Row 3: Operations -->
        </Grid.RowDefinitions>

        <!-- HERO BANNER -->
        <Border Grid.Row="0" Margin="0,0,0,25" CornerRadius="16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#991B1B" Offset="0"/> <!-- Maroon -->
                    <GradientStop Color="#DC2626" Offset="1"/> <!-- Red -->
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Good Afternoon, Librarian 👋" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="Here is what's happening in your library today." FontSize="14" Foreground="#E0E7FF" Opacity="0.9"/>
                </StackPanel>
                <!-- Quick Date/Time -->
                <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="10" Padding="15,10">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCalendar}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:dd MMM yyyy}'}" 
                                   Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 1: KPIs (The Pulse) -->
        <Grid Grid.Row="1" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Total Collection -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FEF2F2" Width="32" Height="32" CornerRadius="10">
                                <TextBlock Text="📚" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Books" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding TotalBooksCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DeepText}"/>
                </StackPanel>
            </Border>

            <!-- 2. Active Issues -->
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FEF2F2" Width="32" Height="32" CornerRadius="10">
                                <TextBlock Text="🔄" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Issued Now" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding IssuedBooksList.Count}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource HighlightBrush}"/>
                </StackPanel>
            </Border>

            <!-- 3. Overdue (Critical) -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FEF2F2" Width="32" Height="32" CornerRadius="10">
                                <TextBlock Text="⚠️" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Overdue" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding OverdueBooksCount}" FontSize="28" FontWeight="Bold" Foreground="#F43F5E"/>
                </StackPanel>
            </Border>

            <!-- 4. Fines -->
            <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="0">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FEF2F2" Width="32" Height="32" CornerRadius="10">
                                <TextBlock Text="💰" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Collections" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource HighlightBrush}">
                        <Run Text="$"/><Run Text="{Binding PendingFines, Mode=OneWay, StringFormat={}{0:0.00}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ROW 2: ACTIONS -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search Bar (Accessible) -->
            <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Height="50" Margin="0,0,20,0">
                <Grid Margin="15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtDashSearch" TextChanged="SearchBox_TextChanged" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource DeepText}" CaretBrush="{DynamicResource DeepText}"/>
                    <TextBlock Grid.Column="1" Text="Search anything..." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtDashSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="BtnOpenAddBook_Click" Background="{DynamicResource HighlightBrush}" Foreground="White" Padding="20,0" Height="50" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconPlus}" Fill="White" Width="12" Height="12" Margin="0,0,8,0"/>
                                    <ContentPresenter/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    Add Book
                </Button>
                
                <Button Click="BtnOpenAddMember_Click" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Foreground="{DynamicResource DeepText}" Padding="20,0" Height="50" FontSize="14" FontWeight="SemiBold">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconMembers}" Fill="{DynamicResource DeepText}" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <ContentPresenter/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    Add Student
                </Button>
            </StackPanel>
        </Grid>

        <!-- ROW 3: OPERATIONS (Split View) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/> <!-- Main (Alerts) -->
                <ColumnDefinition Width="1*"/>   <!-- Side (Activity) -->
            </Grid.ColumnDefinitions>

            <!-- Main Area: ALERTS & TASKS -->
            <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,20,0">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Action Required" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DeepText}"/>
                        <TextBlock Text="Overdue books and pending tasks" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Overdue List (No nested ScrollViewer needed if we use DataGrid scrolling) -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding OverdueBooks}" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="50">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Book Title" Binding="{Binding Title}" Width="2*">
                                 <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DeepText}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="Borrower" Binding="{Binding BorrowedBy}" Width="1.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="BtnSendReminder_Click" Content="Remind" Background="#F43F5E" Foreground="White" 
                                                FontSize="11" FontWeight="Bold" Padding="12,6" BorderThickness="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Side Area: ACTIVITY FEED -->
            <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Recent Activity" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DeepText}" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource HighlightBrush}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource DeepText}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Time}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
