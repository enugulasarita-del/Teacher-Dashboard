<Window x:Class="LibrarianDashboard.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VSIT Librarian Login" Height="600" Width="900"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" AllowsTransparency="True">
    
    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.5"/>
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="20" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
        <Grid>
            <!-- SPLASH SCREEN -->
            <Grid x:Name="SplashGrid" Visibility="Visible" Background="White">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                     <Image Source="vidyalankar_logo.png" Width="300" Height="100" Stretch="Uniform"/>
                    <TextBlock Text="L I B R A R Y   M A N A G E M E N T   S Y S T E M" 
                               FontSize="12" FontWeight="Bold" Foreground="#B91C1C" 
                               HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <ProgressBar IsIndeterminate="True" Width="150" Height="4" BorderThickness="0" Background="#F1F5F9" Foreground="#DC2626" Margin="0,30,0,0"/>
                </StackPanel>
            </Grid>

            <!-- LOGIN SCREEN -->
            <Grid x:Name="LoginGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/> <!-- Brand Side -->
                    <ColumnDefinition Width="*"/>   <!-- Form Side -->
                </Grid.ColumnDefinitions>

                <!-- Left: Brand -->
                <Border Grid.Column="0" CornerRadius="20,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7F1D1D" Offset="0"/>
                            <GradientStop Color="#B91C1C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                          <!-- Image removed as per user request -->
                          <!-- <Image Source="vidyalankar_logo.png" Width="220" Stretch="Uniform" Margin="0,0,0,30"/> -->
                          <TextBlock Text="Welcome Back" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                         <TextBlock Text="Manage your library comfortably." FontSize="14" Foreground="#FECACA" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Right: Form -->
                <Grid Grid.Column="1" Margin="50">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Librarian Login" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <TextBlock Text="Please enter your credentials to access." FontSize="14" Foreground="#64748B" Margin="0,0,0,30"/>

                        <TextBlock Text="Email ID" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtEmail" Height="45" Padding="10" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" 
                                 Background="White" Foreground="#0F172A" Text="admin@vsit.edu.in"/>

                        <TextBlock Text="Password" Foreground="#475569" FontWeight="SemiBold" Margin="0,20,0,5"/>
                        <PasswordBox x:Name="TxtPass" Height="45" Padding="10" FontSize="14" BorderBrush="#CBD5E1" BorderThickness="1" 
                                     Background="White" Foreground="#0F172A"/>

                        <Button Click="BtnLogin_Click" Content="Secure Login" Margin="0,30,0,0" Height="50"
                                Background="#B91C1C" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button Click="BtnClose_Click" Content="Exit Application" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" Margin="0,15,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
